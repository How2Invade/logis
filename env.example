# Copy to .env.local (git-ignored) and fill in. Restart `npm run dev` after editing.

# --- Action tab: AI voice recall calls (Vapi) ---
# Private API key from the Vapi dashboard.
VAPI_API_KEY=
# Id of a phone number imported into Vapi (Twilio, Vonage or Telnyx). Vapi's free numbers cannot call out.
VAPI_PHONE_NUMBER_ID=
# Calls run at once; extra contacts wait in a queue. Must not exceed your Vapi plan's concurrency.
VOICE_CONCURRENCY=10
# Optional: the LLM and voice the call agent uses inside Vapi.
# VAPI_MODEL_PROVIDER=openai
# VAPI_MODEL=gpt-4o
# VAPI_VOICE_PROVIDER=11labs
# VAPI_VOICE_ID=

# --- Action tab: recall notices and structured call feedback (Claude) ---
ANTHROPIC_API_KEY=
